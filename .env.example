# Supabase Postgres - use Session pooler on Windows (IPv4-friendly).
# Dashboard > Project Settings > Database > Connection string > Session pooler > URI
# Example (replace region, ref, password):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# Direct connection (db.<ref>.supabase.co) is IPv6-only and often fails on Windows.
# Do NOT use pr_db.* - that hostname does not exist.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
CLIENT_URL=http://localhost:5000
SERVE_FRONTEND=true

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SHORTCODE=
